# ── Provider selection ──────────────────────────────────────────────────────
# "openrouter" = free cloud models (no cost)
# "openai"     = OpenAI API (paid)
PROVIDER=openrouter

# ── OpenRouter — Free Cloud Models ──────────────────────────────────────────
# Get your free key at https://openrouter.ai/keys  (no credit card needed)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Best free cloud models (all $0 — just change this line to switch):
#   deepseek/deepseek-r1-0528:free          ← strongest reasoning (default)
#   deepseek/deepseek-chat-v3-0324:free     ← fast & smart chat
#   meta-llama/llama-4-maverick:free        ← Meta latest
#   meta-llama/llama-3.3-70b-instruct:free  ← large Llama
#   mistralai/mistral-small-3.1-24b-instruct:free
#   google/gemma-3-27b-it:free
#   qwen/qwen-2.5-72b-instruct:free
#   nvidia/llama-3.1-nemotron-70b-instruct:free
#   moonshotai/kimi-k2:free
OPENROUTER_MODEL=deepseek/deepseek-r1-0528:free

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
